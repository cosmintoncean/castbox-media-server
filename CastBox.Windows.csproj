<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CastBox</AssemblyName>
    <ApplicationIcon>CastBox.ico</ApplicationIcon>
    <RootNamespace>CastBox</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The test project lives in tests/ and must not be compiled into the app. -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="castbox-logo.png" LogicalName="CastBox.castbox-logo.png" />
    <EmbeddedResource Include="CastBox.ico" LogicalName="CastBox.CastBox.ico" />
  </ItemGroup>
</Project>
